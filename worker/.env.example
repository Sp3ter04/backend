# Worker config
WORKER_HOST=127.0.0.1
WORKER_PORT=8000

# WhisperX
WHISPERX_DEVICE=cpu          # cpu | cuda
WHISPERX_COMPUTE_TYPE=int8   # int8 (cpu) | float16 (cuda)
WHISPERX_LANGUAGE=pt

# Where audio files live on disk. The worker reads {AUDIO_BASE_PATH}/{audio_path}
# Locally this is the Laravel public storage symlink target.
AUDIO_BASE_PATH=../storage/app/public

# Laravel internal endpoint that persists the timestamps
LARAVEL_INTERNAL_URL=http://127.0.0.1:8001/api/internal/exercises
INTERNAL_API_TOKEN=change-me

# Backfill: where to read exercises from (PostgREST / Supabase REST)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
